                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Stamp_source_type": {
          "type": "Select",
          "inputs": {
            "from": "@json(triggerBody()?['text'])",
            "select": "@setProperty(item(), 'sourceType', 'Power Pages')"
          },
          "runAfter": {}
        },
        "Route": {
          "type": "Workflow",
          "inputs": {
            "host": {
              "workflowReferenceName": "f8928ed3-a5e7-f111-84e9-7ced8d3b4354"
            },
            "body": {
              "text": "@{string(body('Stamp_source_type'))}"
            }
          },
