{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pplf_sharedoffice365"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "PPLF | Log Target (pplf_LogTarget)": {
          "defaultValue": "Dataverse",
          "type": "String",
          "metadata": {
            "schemaName": "pplf_LogTarget",
            "description": "Where routed logs are written: Dataverse, SharePoint or Both."
          }
        },
        "PPLF | Alert Minimum Level (pplf_AlertMinimumLevel)": {
          "defaultValue": "Critical",
          "type": "String",
          "metadata": {
            "schemaName": "pplf_AlertMinimumLevel",
            "description": "Entries at or above this level trigger an email alert. None turns alerts off."
          }
        },
        "PPLF | Alert Recipients (pplf_AlertRecipients)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "pplf_AlertRecipients",
            "description": "Semicolon-separated email addresses for alerts."
          }
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "a116c0f4-c8ac-44e2-aa6f-e32e08ea6828"
          },
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "LogsJson",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "JSON array of PPLF log entries (see schema/log-entry.schema.json)",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Severity_Map": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "22d2faad-19a2-4189-ae81-c3de016e489b"
          },
          "type": "Compose",
          "inputs": {
            "Trace": 0,
            "Debug": 1,
            "Information": 2,
            "Warning": 3,
            "Error": 4,
            "Critical": 5,
            "None": 99
          }
        },
        "SourceType_Map": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "54b2b396-e392-4838-8dcd-04bd2590984b"
          },
          "type": "Compose",
          "inputs": {
            "Canvas App": 917000000,
            "Model-driven App": 917000001,
            "Cloud Flow": 917000002,
            "Power Pages": 917000003,
            "Plug-in": 917000004,
            "Custom": 917000005
          }
        },
        "Entries": {
          "runAfter": {
            "Severity_Map": [
              "Succeeded"
            ],
            "SourceType_Map": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "8eb139ce-1880-425d-a0d1-c9fde2adbca1"
          },
          "type": "Compose",
          "inputs": "@json(triggerBody()?['text'])"
        },
        "Route_by_target": {
          "runAfter": {
            "Entries": [
              "Succeeded"
            ]
          },
          "cases": {
            "SharePoint": {
              "case": "SharePoint",
              "actions": {
                "Write_to_SharePoint": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "44644a4f-0837-45bf-bf98-9e4af371cd07"
                  },
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "ea928ed3-a5e7-f111-84e9-7ced8d3b4354"
                    },
                    "body": {
                      "text": "@{triggerBody()?['text']}"
                    }
                  }
                }
              }
            },
            "Both": {
              "case": "Both",
              "actions": {
                "Write_to_Dataverse_both": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "dd5b2f46-d400-40b7-bb15-484bf568c242"
                  },
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "dc928ed3-a5e7-f111-84e9-7ced8d3b4354"
                    },
                    "body": {
                      "text": "@{triggerBody()?['text']}"
                    }
                  }
                },
                "Write_to_SharePoint_both": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "3342ff5e-2bd4-415b-b0e8-f71f84848203"
                  },
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "ea928ed3-a5e7-f111-84e9-7ced8d3b4354"
                    },
                    "body": {
                      "text": "@{triggerBody()?['text']}"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "actions": {
              "Write_to_Dataverse": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "f1a27cce-ceb3-4b20-886a-75eccf84f2a5"
                },
                "type": "Workflow",
                "inputs": {
                  "host": {
                    "workflowReferenceName": "dc928ed3-a5e7-f111-84e9-7ced8d3b4354"
                  },
                  "body": {
                    "text": "@{triggerBody()?['text']}"
                  }
                }
              }
            }
          },
          "expression": "@parameters('PPLF | Log Target (pplf_LogTarget)')",
          "metadata": {
            "operationMetadataId": "cf8860d4-b0e5-4704-8194-cfaa825d5816"
          },
          "type": "Switch"
        },
        "Alert_entries": {
          "runAfter": {
            "Entries": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "5d93199e-8d49-41c2-a6b8-53bc2e4a4cce"
          },
          "type": "Query",
          "inputs": {
            "from": "@outputs('Entries')",
            "where": "@and(not(equals(parameters('PPLF | Alert Minimum Level (pplf_AlertMinimumLevel)'), 'None')), greaterOrEquals(coalesce(outputs('Severity_Map')?[item()?['level']], 2), coalesce(outputs('Severity_Map')?[parameters('PPLF | Alert Minimum Level (pplf_AlertMinimumLevel)')], 2)))"
          }
        },
        "Send_alert_if_needed": {
          "actions": {
            "Alert_table": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "4247850f-2909-483d-90bb-8c8e691263b0"
              },
              "type": "Table",
              "inputs": {
                "from": "@body('Alert_entries')",
                "format": "HTML",
                "columns": [
                  {
                    "header": "Level",
                    "value": "@item()?['level']"
                  },
                  {
                    "header": "Source",
                    "value": "@item()?['sourceName']"
                  },
                  {
                    "header": "Component",
                    "value": "@item()?['component']"
                  },
                  {
                    "header": "Message",
                    "value": "@item()?['message']"
                  },
                  {
                    "header": "Correlation Id",
                    "value": "@item()?['correlationId']"
                  },
                  {
                    "header": "When (UTC)",
                    "value": "@coalesce(item()?['clientTimestamp'], utcNow())"
                  }
                ]
              }
            },
            "Send_alert_email": {
              "runAfter": {
                "Alert_table": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "2ecd64b7-d503-41be-87c3-99797b0805d6"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('PPLF | Alert Recipients (pplf_AlertRecipients)')",
                  "emailMessage/Subject": "[PPLF] @{length(body('Alert_entries'))} alert(s) from @{first(body('Alert_entries'))?['sourceName']}",
                  "emailMessage/Body": "<p>The Power Platform Logging Framework recorded entries at or above the alert level.</p>@{body('Alert_table')}",
                  "emailMessage/Importance": "High"
                },
                "authentication": {
                  "type": "Raw",
                  "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
                }
              }
            }
          },
          "runAfter": {
            "Alert_entries": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(body('Alert_entries'))",
                  0
                ]
              },
              {
                "not": {
                  "equals": [
                    "@trim(parameters('PPLF | Alert Recipients (pplf_AlertRecipients)'))",
                    ""
                  ]
                }
              }
            ]
          },
          "metadata": {
            "operationMetadataId": "e33476b6-4a41-402b-9034-02f18bd61152"
          },
          "type": "If"
        },
        "Respond": {
          "runAfter": {
            "Route_by_target": [
              "Succeeded",
              "Failed",
              "Skipped"
            ],
            "Send_alert_if_needed": [
              "Succeeded",
              "Failed",
              "Skipped"
            ]
          },
          "metadata": {
            "operationMetadataId": "97c447d3-9495-4add-af18-67ef9f90ba1d"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "accepted": "@{length(outputs('Entries'))}",
              "target": "@{parameters('PPLF | Log Target (pplf_LogTarget)')}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "accepted": {
                  "title": "accepted",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                },
                "target": {
                  "title": "target",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}