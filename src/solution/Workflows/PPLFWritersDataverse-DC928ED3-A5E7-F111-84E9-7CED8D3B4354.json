{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pplf_sharedcommondataserviceforapps"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "PPLF | Default Minimum Level (pplf_DefaultMinimumLevel)": {
          "defaultValue": "Information",
          "type": "String",
          "metadata": {
            "schemaName": "pplf_DefaultMinimumLevel",
            "description": "Used when no config row matches a source and there is no * row."
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "LogsJson",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "JSON array of PPLF log entries (see schema/log-entry.schema.json)",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Severity_Map": {
          "type": "Compose",
          "inputs": {
            "Trace": 0,
            "Debug": 1,
            "Information": 2,
            "Warning": 3,
            "Error": 4,
            "Critical": 5,
            "None": 99
          },
          "runAfter": {}
        },
        "SourceType_Map": {
          "type": "Compose",
          "inputs": {
            "Canvas App": 917000000,
            "Model-driven App": 917000001,
            "Cloud Flow": 917000002,
            "Power Pages": 917000003,
            "Plug-in": 917000004,
            "Custom": 917000005
          },
          "runAfter": {}
        },
        "Written": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Written",
                "type": "integer",
                "value": 0
              }
            ]
          },
          "runAfter": {}
        },
        "Entries": {
          "type": "Compose",
          "inputs": "@json(triggerBody()?['text'])",
          "runAfter": {
            "Severity_Map": [
              "Succeeded"
            ],
            "SourceType_Map": [
              "Succeeded"
            ],
            "Written": [
              "Succeeded"
            ]
          }
        },
        "List_config": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pplf_logconfigs",
              "$select": "pplf_name,pplf_minimumseverity,pplf_enabled",
              "$filter": "statecode eq 0"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Entries": [
              "Succeeded"
            ]
          }
        },
        "Default_config": {
          "type": "Query",
          "inputs": {
            "from": "@outputs('List_config')?['body/value']",
            "where": "@equals(item()?['pplf_name'], '*')"
          },
          "runAfter": {
            "List_config": [
              "Succeeded"
            ]
          }
        },
        "For_each_entry": {
          "type": "Foreach",
          "foreach": "@outputs('Entries')",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 20
            }
          },
          "actions": {
            "Source_config": {
              "type": "Query",
              "inputs": {
                "from": "@outputs('List_config')?['body/value']",
                "where": "@equals(toLower(item()?['pplf_name']), toLower(items('For_each_entry')?['sourceName']))"
              },
              "runAfter": {}
            },
            "Effective_config": {
              "type": "Compose",
              "inputs": "@if(greater(length(body('Source_config')), 0), first(body('Source_config')), if(greater(length(body('Default_config')), 0), first(body('Default_config')), json(concat('{\"pplf_enabled\":true,\"pplf_minimumseverity\":', string(coalesce(outputs('Severity_Map')?[parameters('PPLF | Default Minimum Level (pplf_DefaultMinimumLevel)')], 2)), '}'))))",
              "runAfter": {
                "Source_config": [
                  "Succeeded"
                ]
              }
            },
            "Should_write": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@outputs('Effective_config')?['pplf_enabled']",
                      true
                    ]
                  },
                  {
                    "greaterOrEquals": [
                      "@coalesce(outputs('Severity_Map')?[items('For_each_entry')?['level']], 2)",
                      "@outputs('Effective_config')?['pplf_minimumseverity']"
                    ]
                  }
                ]
              },
              "actions": {
                "Add_log_row": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "pplf_logs",
                      "item/pplf_name": "@take(coalesce(items('For_each_entry')?['message'], '(no message)'), 200)",
                      "item/pplf_level": "@add(917000000, coalesce(outputs('Severity_Map')?[items('For_each_entry')?['level']], 2))",
                      "item/pplf_severity": "@coalesce(outputs('Severity_Map')?[items('For_each_entry')?['level']], 2)",
                      "item/pplf_sourcetype": "@coalesce(outputs('SourceType_Map')?[items('For_each_entry')?['sourceType']], 917000005)",
                      "item/pplf_sourcename": "@take(items('For_each_entry')?['sourceName'], 200)",
                      "item/pplf_component": "@take(coalesce(items('For_each_entry')?['component'], ''), 200)",
                      "item/pplf_operation": "@take(coalesce(items('For_each_entry')?['operation'], ''), 200)",
                      "item/pplf_message": "@take(coalesce(items('For_each_entry')?['message'], '(no message)'), 4000)",
                      "item/pplf_details": "@take(coalesce(items('For_each_entry')?['details'], ''), 100000)",
                      "item/pplf_correlationid": "@coalesce(items('For_each_entry')?['correlationId'], '')",
                      "item/pplf_sessionid": "@coalesce(items('For_each_entry')?['sessionId'], '')",
                      "item/pplf_userprincipalname": "@coalesce(items('For_each_entry')?['userPrincipalName'], '')",
                      "item/pplf_environment": "@coalesce(items('For_each_entry')?['environment'], workflow()?['tags']?['environmentName'])",
                      "item/pplf_appversion": "@coalesce(items('For_each_entry')?['appVersion'], '')",
                      "item/pplf_runurl": "@coalesce(items('For_each_entry')?['runUrl'], '')",
                      "item/pplf_durationms": "@items('For_each_entry')?['durationMs']",
                      "item/pplf_errorcode": "@coalesce(items('For_each_entry')?['errorCode'], '')",
                      "item/pplf_clienttimestamp": "@coalesce(items('For_each_entry')?['clientTimestamp'], utcNow())",
                      "item/pplf_clientinfo": "@take(coalesce(items('For_each_entry')?['clientInfo'], ''), 500)"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Count_written": {
                  "type": "IncrementVariable",
                  "inputs": {
                    "name": "Written",
                    "value": 1
                  },
                  "runAfter": {
                    "Add_log_row": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Effective_config": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Default_config": [
              "Succeeded"
            ]
          }
        },
        "Respond": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "written": "@{variables('Written')}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "written": {
                  "title": "written",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          },
          "runAfter": {
            "For_each_entry": [
              "Succeeded",
              "Failed"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}