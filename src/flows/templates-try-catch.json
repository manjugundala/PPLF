{
  "$comment": "GENERATED by tools/build/generate.mjs from schema/pplf.schema.json. Do not edit by hand.",
  "name": "PPLF | Templates | Try Catch",
  "description": "Copy this flow to start a new one with PPLF logging built in: Try / Catch / Finally scopes, a correlation id, failure details and a run link.",
  "clientdata": {
    "properties": {
      "connectionReferences": {},
      "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "parameters": {
          "$connections": {
            "defaultValue": {},
            "type": "Object"
          },
          "$authentication": {
            "defaultValue": {},
            "type": "SecureObject"
          }
        },
        "triggers": {
          "manual": {
            "type": "Request",
            "kind": "Button",
            "inputs": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "title": "CorrelationId",
                    "type": "string",
                    "x-ms-dynamically-added": true,
                    "description": "Optional. Pass one in to tie this run to the app action that started it.",
                    "x-ms-content-hint": "TEXT"
                  }
                },
                "required": []
              }
            }
          }
        },
        "actions": {
          "CorrelationId": {
            "type": "InitializeVariable",
            "inputs": {
              "variables": [
                {
                  "name": "CorrelationId",
                  "type": "string",
                  "value": "@{coalesce(triggerBody()?['text'], guid())}"
                }
              ]
            },
            "runAfter": {}
          },
          "Started": {
            "type": "InitializeVariable",
            "inputs": {
              "variables": [
                {
                  "name": "Started",
                  "type": "string",
                  "value": "@{utcNow()}"
                }
              ]
            },
            "runAfter": {
              "CorrelationId": [
                "Succeeded"
              ]
            }
          },
          "Try": {
            "type": "Scope",
            "actions": {
              "Your_steps_go_here": {
                "type": "Compose",
                "inputs": "Replace this with the real work.",
                "runAfter": {}
              }
            },
            "runAfter": {
              "Started": [
                "Succeeded"
              ]
            }
          },
          "Catch": {
            "type": "Scope",
            "actions": {
              "Failed_actions": {
                "type": "Query",
                "inputs": {
                  "from": "@result('Try')",
                  "where": "@contains(createArray('Failed', 'TimedOut'), item()?['status'])"
                },
                "runAfter": {}
              },
              "Log_error": {
                "type": "Workflow",
                "inputs": {
                  "host": {
                    "workflowReferenceName": "{{flow:PPLF | Logger | Write Log}}"
                  },
                  "body": {
                    "text": "Error",
                    "text_1": "@{coalesce(first(body('Failed_actions'))?['error']?['message'], first(body('Failed_actions'))?['outputs']?['body']?['error']?['message'], 'A step in Try failed')}",
                    "text_2": "@{workflow()?['tags']?['flowDisplayName']}",
                    "text_3": "@{first(body('Failed_actions'))?['name']}",
                    "text_5": "@{string(body('Failed_actions'))}",
                    "text_6": "@{variables('CorrelationId')}",
                    "text_7": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}",
                    "text_8": "@{first(body('Failed_actions'))?['code']}"
                  }
                },
                "runAfter": {
                  "Failed_actions": [
                    "Succeeded"
                  ]
                }
              },
              "Fail_the_run": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "PPLF_TRY_FAILED",
                    "message": "@{first(body('Failed_actions'))?['name']} failed. See the PPLF log for details."
                  }
                },
                "runAfter": {
                  "Log_error": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              }
            },
            "runAfter": {
              "Try": [
                "Failed",
                "TimedOut"
              ]
            }
          },
          "Finally": {
            "type": "Scope",
            "actions": {
              "Log_completed": {
                "type": "Workflow",
                "inputs": {
                  "host": {
                    "workflowReferenceName": "{{flow:PPLF | Logger | Write Log}}"
                  },
                  "body": {
                    "text": "Information",
                    "text_1": "Run completed",
                    "text_2": "@{workflow()?['tags']?['flowDisplayName']}",
                    "text_3": "Finally",
                    "text_5": "",
                    "text_6": "@{variables('CorrelationId')}",
                    "text_7": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                  }
                },
                "runAfter": {}
              }
            },
            "runAfter": {
              "Try": [
                "Succeeded"
              ]
            }
          }
        },
        "outputs": {}
      },
      "templateName": ""
    },
    "schemaVersion": "1.0.0.0"
  }
